{
  "version": 2,
  "installCommand": "cd multi-e-commerce-app && npm install",
  "buildCommand": "cd multi-e-commerce-app && npm run build",
  "outputDirectory": "multi-e-commerce-app/dist",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://lango-market-pluse-4fje.onrender.com/api/$1"
    },
    {
      "source": "/v1/(.*)",
      "destination": "https://lango-market-pluse-4fje.onrender.com/api/v1/$1"
    },
    {
      "source": "/webhooks/(.*)",
      "destination": "https://lango-market-pluse-4fje.onrender.com/webhooks/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
